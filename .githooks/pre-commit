#!/bin/bash
# Pre-commit hook — blocks commits publishing protected files (R101)
# Install: git config core.hooksPath .githooks
# Les suppressions (diff-filter exclut D) restent autorisees : detracker un
# fichier protege est le chemin de conformite R76, pas une fuite (le blob
# reste de toute facon dans l'historique).

PROTECTED_FILES=(
  "SESSION_SUMMARY.md"
  "PLAN.md"
  "PRD.md"
  "decision.md"
  "ideas.md"
  "mom_test_results.md"
  "mom_test_script.md"
  "moat.md"
  "architecture_notes.md"
  ".env"
)

STAGED_PUBLISHED=$(git diff --cached --name-only --diff-filter=ACMR)
for file in "${PROTECTED_FILES[@]}"; do
  if echo "$STAGED_PUBLISHED" | grep -q "^$file$"; then
    echo "BLOCKED: $file is a protected file (R101). Remove it from the commit."
    exit 1
  fi
done

# Also block .env.* patterns
if echo "$STAGED_PUBLISHED" | grep -qE '\.env\.'; then
  echo "BLOCKED: .env.* files are protected (R10). Remove them from the commit."
  exit 1
fi

# Block *.key and *.pem
if echo "$STAGED_PUBLISHED" | grep -qE '\.(key|pem)$'; then
  echo "BLOCKED: Key/pem files are protected (R10). Remove them from the commit."
  exit 1
fi

exit 0
